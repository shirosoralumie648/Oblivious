FROM golang:1.25-alpine AS builder
WORKDIR /build
COPY src/server/go.mod src/server/go.sum ./
RUN go mod download
COPY src/server/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /chat ./cmd/chat

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
COPY --from=builder /chat /chat
EXPOSE 8080
CMD ["/chat"]
