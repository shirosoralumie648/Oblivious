FROM golang:1.25-alpine AS builder
WORKDIR /build
COPY src/server/go.mod src/server/go.sum ./
RUN go mod download
COPY src/server/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /admin ./cmd/admin

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
COPY --from=builder /admin /admin
EXPOSE 8080
CMD ["/admin"]
