# Frontend local development
WEB_PORT=5173
WEB_API_BASE_URL=http://localhost:8080

# Backend runtime
SERVER_PORT=8080
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/oblivious?sslmode=disable
DB_URL_RELAY=postgres://postgres:postgres@localhost:5432/oblivious?sslmode=disable
DB_URL_CHAT=postgres://postgres:postgres@localhost:5432/oblivious?sslmode=disable
DB_URL_WORKFLOW=postgres://postgres:postgres@localhost:5432/oblivious?sslmode=disable
DB_URL_RAG=postgres://postgres:postgres@localhost:5432/oblivious?sslmode=disable
DB_URL_AGENT=postgres://postgres:postgres@localhost:5432/oblivious?sslmode=disable
DB_URL_BILLING=postgres://postgres:postgres@localhost:5432/oblivious?sslmode=disable
DB_URL_MARKETPLACE=postgres://postgres:postgres@localhost:5432/oblivious?sslmode=disable
DB_URL_ADMIN=postgres://postgres:postgres@localhost:5432/oblivious?sslmode=disable
DB_URL_CHANNEL=postgres://postgres:postgres@localhost:5432/oblivious?sslmode=disable
DB_URL_TASK=postgres://postgres:postgres@localhost:5432/oblivious?sslmode=disable
DB_URL_OBSERVABILITY=postgres://postgres:postgres@localhost:5432/oblivious?sslmode=disable
# Development placeholder only. Production requires a non-default 32+ character secret.
SESSION_SECRET=change-me
# Distinct high-entropy at-rest secret key recommended; production rejects legacy plaintext stored secrets.
OBLIVIOUS_SECRET_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=oblivious_session
# Production requires true.
SESSION_COOKIE_SECURE=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
MODEL_DEFAULT_NAME=demo-reply

# Standalone Agent runtime
AGENT_PORT=8083
AGENT_GRPC_PORT=50063
AGENT_GRPC_ADDR=localhost:50063
AGENT_RELAY_BASE_URL=http://localhost:8080/v1

# Standalone Workflow and Task runtimes
WORKFLOW_PORT=8082
WORKFLOW_GRPC_PORT=50064
WORKFLOW_GRPC_ADDR=localhost:50064
TASK_PORT=8084
TASK_GRPC_PORT=50065
TASK_GRPC_ADDR=localhost:50065
KAFKA_BROKERS=localhost:9092

# Workflow system guardrails. Empty disables the corresponding global guard.
WORKFLOW_SYSTEM_MAX_CONCURRENT=
WORKFLOW_GLOBAL_MAX_EXECUTIONS_PER_MINUTE=
WORKFLOW_RELAY_BASE_URL=

# Relay configuration
# Production deployments must keep Relay enabled; disabling Relay is only for non-production local development.
RELAY_ENABLED=true
RELAY_DEFAULT_MODEL=gpt-4o-mini
RELAY_SEMANTIC_CACHE_BACKEND=memory
RELAY_RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=
RELAY_RATE_LIMIT_REDIS_KEY_PREFIX=relay:rate_limit
# Batch remains disabled in production unless the full async lifecycle is deployed and proven.
RELAY_BATCH_COMMERCIAL_LIFECYCLE_ENABLED=false
RELAY_BATCH_POLLING_WORKER_ENABLED=false
RELAY_BATCH_POLLING_WORKER_INTERVAL_MS=60000
RELAY_BATCH_POLLING_WORKER_CLAIM_LIMIT=10
# Realtime remains disabled in production unless auth, origin, prebill, abort settlement, and usage evidence are deployed and proven.
RELAY_REALTIME_COMMERCIAL_LIFECYCLE_ENABLED=false

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_VECTOR_SIZE=1536
# Production deployments with QDRANT_URL set must keep this worker enabled.
RAG_INDEX_WORKER_ENABLED=true
RAG_INDEX_WORKER_INTERVAL_MS=60000
RAG_INDEX_WORKER_CLAIM_LIMIT=10
# Consumes durable Knowledge upload/content ingestion jobs and creates documents with embeddings.
RAG_INGESTION_WORKER_ENABLED=true
RAG_INGESTION_WORKER_INTERVAL_MS=60000
RAG_INGESTION_WORKER_CLAIM_LIMIT=10

# RAG reranker
RAG_RERANKER_BASE_URL=
RAG_RERANKER_API_KEY=
RAG_RERANKER_MODEL=bge-reranker-large
RAG_RERANKER_TOP_K=5

# Observability
# Set OBSERVABILITY_REQUEST_LOG_BACKEND=clickhouse to stream HTTP/Relay request logs into ClickHouse request_logs.
# Production Relay deployments must not use OBSERVABILITY_REQUEST_LOG_BACKEND=none.
OBSERVABILITY_REQUEST_LOG_BACKEND=none
CLICKHOUSE_DSN=
CLICKHOUSE_DRIVER=clickhouse
OBSERVABILITY_HTTP_ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
OBSERVABILITY_HTTP_LATENCY_SLO_THRESHOLD_MS=5000
# Recovery audit records planned remediation actions only; it does not mutate infrastructure.
OBSERVABILITY_HTTP_RECOVERY_AUDIT_ENABLED=false
OBSERVABILITY_HTTP_RECOVERY_AUDIT_COOLDOWN_MS=300000
# Legacy aliases are still accepted for existing deployments.
# OBSERVABILITY_HTTP_RECOVERY_ENABLED=false
# OBSERVABILITY_HTTP_RECOVERY_COOLDOWN_MS=300000

# Default OpenAI channel (for development)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# Payment providers
# Production requires at least one provider to be fully configured.
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel
STRIPE_WEBHOOK_SECRET=
ALIPAY_CHECKOUT_BASE_URL=
ALIPAY_WEBHOOK_SECRET=
WECHATPAY_CHECKOUT_BASE_URL=
WECHATPAY_WEBHOOK_SECRET=

# Marketplace payouts
# Development defaults to local dispatch. Production requires a non-local provider.
MARKETPLACE_PAYOUT_PROVIDER=local
MARKETPLACE_PAYOUT_WEBHOOK_URL=
MARKETPLACE_PAYOUT_WEBHOOK_SECRET=

# Docker/Kubernetes examples use the same variable names with placeholder values only.
