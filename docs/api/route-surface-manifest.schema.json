{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oblivious.local/schemas/route-surface-manifest-v2.json",
  "title": "Oblivious deterministic route surface manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedFrom",
    "projectionDigest",
    "scope",
    "operations",
    "routeSamples"
  ],
  "properties": {
    "schemaVersion": { "const": "route-surface-manifest/v2" },
    "generatedFrom": { "const": "docs/api/openapi.yaml" },
    "projectionDigest": { "$ref": "#/$defs/digest" },
    "scope": { "$ref": "#/$defs/publicOperationScope" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operationContractMetadata" }
    },
    "routeSamples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/routeSample" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schemaIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "ref" },
            "value": { "type": "string", "pattern": "^#/" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "inline" },
            "value": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "none" },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "mediaSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "schemaIdentity"],
      "properties": {
        "mediaType": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "schemaIdentity": { "$ref": "#/$defs/schemaIdentity" }
      }
    },
    "successResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mediaType", "schemaIdentity"],
      "properties": {
        "status": { "type": "string", "pattern": "^[1-5][0-9][0-9]$" },
        "mediaType": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "schemaIdentity": { "$ref": "#/$defs/schemaIdentity" }
      }
    },
    "operationContractMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "normalizedPath",
        "operationId",
        "security",
        "csrf",
        "capabilityId",
        "request",
        "successResponses"
      ],
      "properties": {
        "method": { "type": "string", "enum": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT", "TRACE"] },
        "normalizedPath": { "type": "string", "pattern": "^/" },
        "operationId": { "type": "string", "minLength": 1 },
        "security": { "type": "string", "enum": ["public", "cookie", "cookie+csrf", "bearer"] },
        "csrf": { "type": "boolean" },
        "capabilityId": { "type": "string", "minLength": 1 },
        "request": { "$ref": "#/$defs/mediaSchema" },
        "successResponses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/successResponse" }
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "normalizedPath", "disposition", "reason"],
      "properties": {
        "method": { "type": "string", "enum": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT", "TRACE"] },
        "normalizedPath": { "type": "string", "pattern": "^/" },
        "disposition": { "type": "string", "enum": ["included", "excluded"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "publicOperationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "mandatoryPrefixes", "dispositions"],
      "properties": {
        "schemaVersion": { "const": "public-operation-scope/v1" },
        "mandatoryPrefixes": {
          "const": ["/api/", "/v1/"]
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        }
      }
    },
    "routeSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "normalizedPath", "samplePath", "tags"],
      "properties": {
        "method": { "type": "string", "enum": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT", "TRACE"] },
        "normalizedPath": { "type": "string", "pattern": "^/" },
        "samplePath": { "type": "string", "pattern": "^/" },
        "sampleQuery": { "type": "string" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
